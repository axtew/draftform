{
  "name": "draftform",
  "version": "0.1.0",
  "description": "A small React hook for flat forms: knows which values are saved, submits only changes, autosaves without races.",
  "keywords": [
    "react",
    "form",
    "hook",
    "forms",
    "autosave",
    "validation",
    "typescript",
    "standard-schema"
  ],
  "license": "MIT",
  "author": "Artur Ovcharenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axtew/draftform.git"
  },
  "homepage": "https://github.com/axtew/draftform#readme",
  "bugs": "https://github.com/axtew/draftform/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile esm-only",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck:compat": "pnpm --package=typescript@5.0 dlx tsc -p tsconfig.compat.json",
    "example:dev": "pnpm build && pnpm --filter draftform-example dev",
    "example:build": "pnpm build && pnpm --filter draftform-example build",
    "example:deploy": "pnpm build && pnpm --filter draftform-example run deploy",
    "bench:size": "pnpm build && pnpm --dir bench/size install --ignore-workspace && pnpm --dir bench/size measure",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:package"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.10.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "~7.0.2",
    "unrun": "^0.3.1",
    "valibot": "^1.5.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=20"
  }
}
